<?xml version="1.0" encoding="UTF-8"?>
<!--
  社区便民服务预约系统（community-booking）
  技术栈锁定：Spring Boot 2.7.18 + JDK 17 + Maven + MySQL 8.0 + MyBatis-Plus 3.5.3.1
  视图层锁定：Thymeleaf + Bootstrap 5 + jQuery + ECharts 5（服务端渲染，禁止 Vue/React）
  进阶组件锁定：Spring Security（BCrypt + 三级角色）+ Redis（限流/分布式锁/缓存）+
              RabbitMQ（延迟队列死信超时取消 + 异步通知/绩效重算）+ Spring Task + JavaMailSender
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 官方父工程，统一管理依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.community</groupId>
    <artifactId>community-booking</artifactId>
    <version>1.0.0</version>
    <name>community-booking</name>
    <description>社区便民服务预约系统</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.3.1</mybatis-plus.version>
    </properties>

    <dependencies>
        <!-- Web 基础：内嵌 Tomcat + Spring MVC，支撑 Thymeleaf 服务端渲染 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 视图层：Thymeleaf 模板引擎（th:fragment / th:replace 抽离公共布局） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- 安全框架：BCrypt 加密 + 三级角色（ROLE_RESIDENT / ROLE_WORKER / ROLE_ADMIN） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Thymeleaf 与 Spring Security 整合标签（sec:authorize 等权限控制） -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity5</artifactId>
        </dependency>

        <!-- 缓存：Redis（服务分类/热点缓存、@RateLimit 预约限流、分布式锁订单状态机幂等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Redis Lettuce 连接池所需对象池 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- 消息队列：RabbitMQ（appoint 延迟队列 TTL30min 死信超时取消、异步通知与绩效重算） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- 邮件：JavaMailSender（次日上门提醒邮件、派单/完成/取消异步通知） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- 参数校验：JSR-303（Controller 层 @Valid） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP：@RateLimit 自定义注解 + 切面实现接口限流（限居民 1 分钟最多提交 3 次预约） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ORM：MyBatis-Plus 3.5.3.1（严禁 ${}，100% #{} 预编译） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- 数据库驱动：MySQL 8.0（Spring Boot 2.7.18 管理 com.mysql:mysql-connector-j 8.0.33，
             旧坐标 mysql:mysql-connector-java 已不被父 POM 管理，故使用新坐标且无需写版本号） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 简化实体样板代码（仅用于 getter/setter，不改变分层架构） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>community-booking</finalName>
        <plugins>
            <!-- 可执行 jar 打包（java -jar 部署） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- 编译插件：锁定 JDK 17 与 UTF-8，并注册 Lombok 注解处理器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
